<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallx.product.mapper.ProductMapper">

    <!--
      countByCategoryId：统计某分类下挂着多少个商品 —— ★ 含【已软删】的商品。

      ★ 本 statement 的【唯一存在理由】就是绕开 @TableLogic：
        Product 实体上有 @TableLogic，所以 productMapper.selectCount(...) 会被
        MyBatis-Plus 自动追加 AND is_deleted = 0，已软删的商品就被漏算了。
        后果链条：漏算 → 删除分类的引用校验以为该分类空着 → 物理删分类 →
        紧接着撞 fk_product_category（NO ACTION）→ 现场 500。

      ★ 判据（本日最值钱的一条）：引用计数的口径必须与【外键的口径】一致。
        外键不认识 is_deleted，计数就不能带它。
        手写 XML 的 SELECT 不走 MP 的 @TableLogic 改写，这正是我们要的效果。

      ⚠️ #{categoryId} 必须与 Java 侧 @Param("categoryId") 逐字一致 ——
         不一致时编译期不报错，要到运行才炸 Invalid bound statement。
    -->
    <select id="countByCategoryId" resultType="java.lang.Long">
        SELECT count(*) FROM products WHERE category_id = #{categoryId}
    </select>

</mapper>
