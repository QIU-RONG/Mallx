<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mallx</groupId>
        <artifactId>mallx</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>mall-server</artifactId>
    <name>mall-server</name>
    <description>MallX 启动模块：Spring Boot 入口，聚合所有业务模块</description>

    <dependencies>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-product</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-cart</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-order</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-payment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-review</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-marketing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-admin</artifactId>
        </dependency>
        <!-- Day 46 · 售后：退款 / 退货退款。
             ⚠️ 漏了这一处的后果不是编译失败，而是【接口 404】——
                （空壳模块写码不用改 POM，但新建模块要改 3 处：父 <modules>、
                  父 <dependencyManagement>、本文件。） -->
        <dependency>
            <groupId>com.mallx</groupId>
            <artifactId>mall-aftersale</artifactId>
        </dependency>
        <!-- V1.1 · D37：Redis 缓存基建。★ 只声明在启动模块 —— RedisAutoConfiguration
             在应用层生效，各业务模块（mall-product 等）编译期需要时再各自声明依赖。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- V1.4 · D42：可观测性。同样只声明在启动模块 —— actuator 是【运行期】关注点
             （健康探针 / 指标），业务模块不依赖它。
             ★ 端点只暴露 health+info，且必须同时在 SecurityConfig 里按【精确路径】放行；
             详见 mall-common 的 SecurityConfig 与 application.yml 的 management 段。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.mallx.MallXApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
