<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mallx</groupId>
        <artifactId>mallx</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <dependencies>
        <!-- Spring Security 本体：版本由 Boot 4.1.1 BOM 托管（=7.1.1），不要手写 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT：api 编译期要用（你代码里 import io.jsonwebtoken.*）；impl/jackson 只在运行期需要 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ★ Day 44：单元测试（此前 189 个源文件、0 个测试类，CI 一直 -DskipTests）。
             spring-boot-starter-test 自带 JUnit 5 + AssertJ + Mockito，版本由父 pom 的
             dependencyManagement 托管（不写 version）。
             ⚠️ scope=test：只进测试 classpath，不打进生产 jar。
             ⚠️ 加依赖不够 —— 必须在被测模块各自加，父 pom 里那份只是版本声明。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <artifactId>mall-common</artifactId>
    <name>mall-common</name>
    <description>MallX 公共模块：统一返回体、异常、工具类等</description>
</project>
