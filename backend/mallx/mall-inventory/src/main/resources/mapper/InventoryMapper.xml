<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallx.inventory.mapper.InventoryMapper">

    <!-- ==========================================================================
         ★★ Day 14 起，本文件三个语句从 <update> 改成 <select>，并在 SQL 末尾加 RETURNING。
         原因：inventory_logs 流水要同时记 before_stock 和 after_stock，
               「改成了多少」只有 RETURNING 能一条语句拿到。

         ★ 为什么必须是 <select>：<update> 会把结果集丢掉，而且它没有 resultType 属性，
           没法接 RETURNING。用 <select> 包住一条 UPDATE，MyBatis 就把 RETURNING 的
           结果集当普通查询结果映射。

         ★★ 为什么必须写 flushCache="true"（★ 实测踩过，不是保险写法）：
           MyBatis 一级缓存（本地缓存，localCacheScope 默认 SESSION）始终开启；
           <select> 会填充它，而只有 insert/update/delete 才会刷新它。
           不写这个属性，同一事务内用相同参数调第二次会直接命中缓存、SQL 根本不发，
           上层以为改成功了、实际数据库没动。
           实测对照（同一 SqlSession，相同参数连调两次 releaseLocked）：
             flushCache="true"  → 第二次照样发 SQL，Total: 0，返回 null            OK
             flushCache="false" → 第二次连 Preparing 行都没有，直接返回陈旧的 147  危险
           本项目真的会踩到：order_items 没有 (order_id, sku_id) 唯一约束，
           一张订单可以有两行同 SKU 同数量的明细，循环里第二次调用的缓存键完全相同。
           useCache="false" 是顺手关掉二级缓存，属保险，不是关键。

         ★★ 返回语义（配合 Java 侧 Integer 返回类型）：
           非 null = 成功，值就是【改完之后】的 available_stock
           null    = 守卫不成立（0 行），RETURNING 空手而归，MyBatis selectOne 返回 null

         ⚠️ updated_at 必须手写：自定义 XML 的 UPDATE 不走 MetaObjectHandler，
            漏了它这一格就永远停在旧时间。
         ⚠️ 减法必须由数据库做（available_stock - #{quantity}），绝不能在 Java 里算好新值
            再 SET 全字段，那就是「先查后改」，两次请求会读到同一个旧值。
         ⚠️ 是 >= 不是 >：库存刚好等于购买量时要能买（Day 10 购物车踩过同一个边界）。
         ========================================================================== -->

    <!-- ★★ Day 12 的核心 SQL：条件扣减（原子动作）
         判定与扣减在同一条语句里完成 —— 数据库执行 UPDATE 时会对命中行加写锁，
         并发的第二个请求会等锁，等到了再重新求值 WHERE，此时 available_stock 已被
         第一个请求改小，条件不再成立 → 0 行 → 上层报「库存不足」。

         ★ 流水口径：type=ORDER_LOCK，change=-n，before=返回值+n，after=返回值。
           reference_id 只能写 NULL（下单是「先扣库存、后插订单」，此刻订单还不存在）。 -->
    <select id="deductStock" resultType="java.lang.Integer" flushCache="true" useCache="false">
        UPDATE inventories
           SET available_stock = available_stock - #{quantity},
               locked_stock    = locked_stock    + #{quantity},
               updated_at      = CURRENT_TIMESTAMP
         WHERE sku_id = #{skuId}
           AND available_stock &gt;= #{quantity}
        RETURNING available_stock
    </select>

    <!-- ★★ Day 13 的核心 SQL：锁定 → 已售（支付成功）
         与 deductStock 同一招：判定 + 转移在同一条语句里完成。

         ★★★ available_stock 一动不动！这件货在下单那一刻就已经从 available 挪进 locked，
             支付只是 locked → sold。再动一次 available 就等于把同一件货扣两遍。

         ★ 正因为 available 不动，本语句 RETURNING 出来的值 = 转移前的值，
           对应流水 change 恒为 0、before == after。这不是「没记到东西」：
           「PAY_SOLD 的 change 必须是 0」本身就是一条可直接断言的铁律 ——
           哪天它不为 0，就说明支付动了 available，Day 13 的事故又回来了。

         ★ locked_stock >= #{quantity} 是守卫：正常流程永远满足；返回 null 说明订单与库存
           已经对不上账（被旁路改过），上层必须抛异常让整笔事务回滚。 -->
    <select id="moveLockedToSold" resultType="java.lang.Integer" flushCache="true" useCache="false">
        UPDATE inventories
           SET locked_stock = locked_stock - #{quantity},
               sold_stock   = sold_stock   + #{quantity},
               updated_at   = CURRENT_TIMESTAMP
         WHERE sku_id = #{skuId}
           AND locked_stock &gt;= #{quantity}
        RETURNING available_stock
    </select>

    <!-- ★★ Day 14 的核心 SQL：锁定 → 可售（取消订单 / 超时关单）
         这是 deductStock 的【严格逆操作】—— 一个 available → locked，一个 locked → available。

         ★★★ available_stock 这里【要动】（它正是不动就错了的那一格）：
             deductStock 把货从可售挪进锁定，取消就是原路挪回去。与 moveLockedToSold 刚好相反。

         ★ 守卫条件仍然是 locked_stock >= #{quantity}，与 moveLockedToSold 一样，不是 available。
             判据永远是「我要动的那一格够不够」：本次要动的是 locked，所以判 locked。
             若错判成 available_stock >= n，就会凭空造货 ——
             「退一件本来没被锁定的货」= 无中生有。
             返回 null = 订单与库存对不上账（被旁路改过），上层必须抛异常整笔回滚。

         ★ 流水口径：type=CANCEL_RELEASE，change=+n，before=返回值-n，after=返回值。 -->
    <select id="releaseLocked" resultType="java.lang.Integer" flushCache="true" useCache="false">
        UPDATE inventories
           SET available_stock = available_stock + #{quantity},
               locked_stock    = locked_stock    - #{quantity},
               updated_at      = CURRENT_TIMESTAMP
         WHERE sku_id = #{skuId}
           AND locked_stock &gt;= #{quantity}
        RETURNING available_stock
    </select>

    <!--
      ★★★ ⑨ Day 17 的核心 SQL：管理端人工调整

      本句是【第四个库存写点】，也是四条里【唯一会改 total_stock 的一条】。
      要求见 InventoryMapper.java#adjustStock 与
      docs/daily/Day-17-管理端订单与库存.md §4.1。要点：

        · UPDATE inventories
             SET total_stock     = total_stock     + #{delta},
                 available_stock = available_stock + #{delta},
                 updated_at      = CURRENT_TIMESTAMP
           WHERE sku_id = #{skuId}
             AND total_stock     + #{delta} &gt;= 0
             AND available_stock + #{delta} &gt;= 0
          RETURNING available_stock

        · ★★ total 与 available 必须【同向同量】移动 —— 管理员改的是守恒式
          （total = available + locked + sold），不是一个数字。
          只改 available 会当场打破恒等式，此后【所有】对账脚本都开始报警，
          而错误会指向「库存流水不对」，离真正的原因（少改了一格）十万八千里。
        · ★★ 绝不碰 locked_stock / sold_stock —— 那两格记的是【已发生的业务事实】
          （谁锁着、谁买过）。要降 locked 只能走「释放超时单」那条业务流程
          （它同时会改订单状态）；单独调它等于让账本与事实脱钩。
        · ★ 两个守卫都写进 WHERE（由数据库原子完成，不是「先查后改」）：
          0 行 = 调整后会出现负数 → 上层抛 400「调整后可用/总库存不能为负」。
          注意这是【用户可理解的业务结果】，
          与 moveLockedToSold / releaseLocked 的 0 行（账目不一致，500）不同类。
        · ★ 包裹方式沿用 Day 13 的定型做法，两条都不能省：
          ① 用 select 标签包住 UPDATE ... RETURNING
             （update 标签会丢掉结果集、也没有 resultType 属性，接不住 RETURNING）；
          ② 必须写 flushCache="true"（一级缓存坑，Day 13 实测过：
             不写它，同一事务内用相同参数调第二次【根本不发 SQL】）。
        · updated_at 必须手写：自定义 XML 的 UPDATE 不走 MetaObjectHandler。
        ⚠️ 返回语义：resultType=java.lang.Integer，值是【改完之后】的 available_stock；
           null = 守卫不成立（0 行，RETURNING 空手而归）。
    -->
    <select id="adjustStock" resultType="java.lang.Integer" flushCache="true" useCache="false">
        TODO
    </select>

    <!--
      ★ ⑩ Day 17 的读 SQL：管理端库存分页（JOIN 出 SKU 名与商品名）

      要求见 InventoryMapper.java#selectInventoryPage。要点：

        · FROM inventories i
            LEFT JOIN product_skus s ON s.id = i.sku_id
            LEFT JOIN products     p ON p.id = s.product_id
        · ★ LEFT JOIN 不是 INNER JOIN：万一某个 SKU 被物理删除而库存行还在，
          INNER JOIN 会让这条库存【从列表里凭空消失】——
          而它恰恰是需要被看见的那一行（对账要的是「账上有什么」，
          不是「能联上的有什么」）。
        · 显式列 + 别名【全用下划线】：
            i.sku_id AS sku_id、s.name AS sku_name、s.product_id AS product_id、
            p.name AS product_name、i.total_stock AS total_stock、
            i.available_stock AS available_stock、i.locked_stock AS locked_stock、
            i.sold_stock AS sold_stock、i.updated_at AS updated_at
          ⚠️ 别名写成 AS skuName 会被 PG 折成 skuname，字段静默为 null 且不报错。
        · 名称兜底：COALESCE(s.name, '(规格已删除)')、COALESCE(p.name, '(商品已删除)')
        · ORDER BY i.sku_id —— 库存列表是【对账视图】，
          顺序稳定（每次刷新都一样）比「最新在最前」重要。
        · ★ 首参 IPage 由 Java 侧传（分页插件靠它改写 SQL），XML 里【不用写】LIMIT/OFFSET
    -->
    <select id="selectInventoryPage" resultType="com.mallx.inventory.vo.InventoryVO">
        SELECT i.sku_id           AS sku_id,
               COALESCE(s.name, '(规格已删除)')   AS sku_name,
               s.product_id       AS product_id,
               COALESCE(p.name, '(商品已删除)')   AS product_name,
               i.total_stock      AS total_stock,
               i.available_stock  AS available_stock,
               i.locked_stock     AS locked_stock,
               i.sold_stock       AS sold_stock,
               i.updated_at       AS updated_at
        FROM inventories i
                 LEFT JOIN product_skus s ON s.id = i.sku_id
                 LEFT JOIN products     p ON p.id = s.product_id
        ORDER BY i.sku_id
    </select>

</mapper>
