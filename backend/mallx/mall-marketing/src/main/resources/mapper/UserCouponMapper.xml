<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallx.marketing.mapper.UserCouponMapper">

    <!--
      ★★★ Day 20 用户优惠券 SQL（2 条，已实写并通过验收：day20-coupon-verify.py 80/80）

      通用规矩见 CouponMapper.xml 顶部那段，同样适用：
        · 方法名与 id 逐字符一致
        · 别名一律下划线
        · XML 注释里不能出现连续两个减号
        · ★ SQL 里的【小于号】必须转义成 &lt;（本文件 selectMyCoupons 的
          `c.end_time &lt; CURRENT_TIMESTAMP` 就是活的例子 —— 裸写 `<` 启动才炸）
        · 自定义 XML 的 INSERT 不走 MetaObjectHandler → 时间戳手写
    -->

    <!--
      ① 写领取记录 —— 与 Day 16 的 ReviewMapper.xml#insertReview 逐字同构
      要求见 UserCouponMapper.java#insertIgnore。

      形状：
          INSERT INTO user_coupons (user_id, coupon_id, status, received_at)
          VALUES (#{userId}, #{couponId}, 'UNUSED', ______)      ← 时间戳手写
          ______                                                  ← 关键那一句

      ★ 最后那句必须让「重复领取」不报错、而是【返回 0 行】——
        这就是它和 Day 16 评价的对应关系：
            Day 16：ON CONFLICT (order_item_id) DO NOTHING   → 0 行 = 该明细已评过
            Day 20：ON CONFLICT (______)        DO NOTHING   → 0 行 = 已领过这张券
        ★ 冲突列写什么，取决于 09-user-coupons-unique.sql 建了哪个唯一约束。
          写错了 → 直接报 "there is no unique or exclusion constraint matching
          the ON CONFLICT specification"（不是静默降级）。

      ⚠️ status 写死 'UNUSED' 字面量。⚠️ received_at 用 CURRENT_TIMESTAMP。
    -->
    <insert id="insertIgnore">
        insert into user_coupons (user_id, coupon_id, status, received_at)
        values (#{userId}, #{couponId}, 'UNUSED', CURRENT_TIMESTAMP)
        on conflict (user_id, coupon_id) do nothing
    </insert>

    <!--
      ② 我的券列表（需登录，分页）
      要求见 UserCouponMapper.java#selectMyCoupons。

      ★ 两表 JOIN：user_coupons uc JOIN coupons c ON c.id = uc.coupon_id
        LEFT 还是 INNER —— 自己选，并把理由写进注释（javadoc 里给了提示）。

      SELECT 要出的列（与 UserCouponVO 一一对应）：
          uc.id / uc.coupon_id / c.name AS coupon_name / c.type
          / c.discount_amount / c.discount_rate / c.min_amount
          / uc.status / uc.received_at / uc.used_at / uc.order_id
          / c.end_time
          / ______ AS expired        ← 现算的布尔列：券是否已过期

      WHERE uc.user_id = #{userId}   ← ★ C 端隔离的唯一防线，写死在这里
      ORDER BY uc.id DESC

      ★ expired 的算法：把 c.end_time 与 CURRENT_TIMESTAMP 比较得出布尔值。
        PG 直接写比较表达式即可，它会返回 boolean；
        这个值【不落库】—— 这就是「惰性过期」，验收会拿 DB 里的 status 仍是 UNUSED 来反证。
      ★ 别名用下划线；不写 LIMIT。
    -->
    <select id="selectMyCoupons" resultType="com.mallx.marketing.vo.UserCouponVO">
        select uc.id, uc.coupon_id, c.name as coupon_name, c.type,
               c.discount_amount, c.discount_rate, c.min_amount,
               uc.status, uc.received_at, uc.used_at, uc.order_id,
               c.end_time, (c.end_time &lt; current_timestamp) as expired
        from user_coupons uc
        join coupons c on c.id = uc.coupon_id
        where uc.user_id = #{userId}
        order by uc.id desc
    </select>

    <!--
      =================================================================
      ★★★ Day 21（阶段二）：算抵扣 / 核销 / 退券（3 条，骨架期【方法体留空】）

      这三条与上面两条的性质不同：
        ① selectForUse  —— 读，只取素材，不写库
        ② markUsed      —— ★ 写，条件 UPDATE（CAS），是「同一张券被并发用掉」的唯一防线
        ③ releaseByOrder—— ★ 写，② 的【逆向】操作：把上次写进去的三样东西全部还原

      ★★ 三条都必须手写的原因（与 CouponMapper.java 顶部同一条理由）：
         它们带「并发」或「多列同时改」的语义，MP 的 wrapper 表达不了。
         MP 的 updateById 会把 null 字段跳过 → 想「把 order_id 清空」根本做不到，
         那正是 releaseByOrder 必须手写的原因（清空 ≠ 不改）。
      =================================================================
    -->

    <!--
      ① 下单算抵扣前的「取素材」—— 要求见 UserCouponMapper.java#selectForUse

      SELECT 要出的列（与 CouponUseSourceVO 一一对应，一条都不能少）：
          uc.id             AS user_coupon_id
          uc.coupon_id      AS coupon_id
          c.name            AS coupon_name
          c.type
          c.discount_amount / c.discount_rate / c.min_amount
          uc.status         AS status            ← user_coupons.status（我用了没）
          c.status          AS coupon_status     ← coupons.status（这个券种下架没）
          c.start_time / c.end_time
          ______            AS expired           ← 现算：c.end_time 与 CURRENT_TIMESTAMP 比

      ★★ 两个 status 必须【分别起别名】。写成两遍 AS status 的话，
         PG 会让后一列盖掉前一列，而且【不报错】——
         status 字段会悄悄变成「券种的上下架标记」，
         于是「已核销的券」被判成可用，同一张券能被用两次。
      ★ WHERE：uc.user_id = #{userId} AND uc.id = #{userCouponId}
        （归属写死在 SQL 里 —— C 端口径，别搬到 Java）
      ★ expired 的算法与上面 ② selectMyCoupons 保持一致，别另立一套。
      ★ 别名一律下划线。⚠️ SQL 里的【小于号】写成 &lt;（裸写启动才炸）。
    -->
    <select id="selectForUse" resultType="com.mallx.marketing.vo.CouponUseSourceVO">
        select uc.id as user_coupon_id, uc.coupon_id, c.name as coupon_name, c.type,
               c.discount_amount, c.discount_rate, c.min_amount,
               uc.status as status, c.status as coupon_status,
               c.start_time, c.end_time, (c.end_time &lt; current_timestamp) as expired
        from user_coupons uc
        join coupons c on c.id = uc.coupon_id
        where uc.user_id = #{userId}
          and uc.id = #{userCouponId}
    </select>

    <!--
      ② 核销：条件 UPDATE（CAS）—— 要求见 UserCouponMapper.java#markUsed

      形状（结构给你，条件你自己列）：
          UPDATE user_coupons
             SET status   = 'USED'
               , order_id = #{orderId}
               , used_at  = ______        ← ★ 自定义 XML 不走填充器，时间戳手写
           WHERE id = #{userCouponId}
             AND ______                    ← 守卫一：归属（不能因为查过一次就省）
             AND ______                    ← 守卫二：当前必须还是 UNUSED ★ 防重复核销的全部

      ★ 用 <update> + int 返回值；不要包 RETURNING。
      ★ 两条守卫缺一条都不报错：少了归属 → 能用别人的券；少了状态 → 能重复核销。
    -->
    <update id="markUsed">
        update user_coupons
        set status = 'USED', order_id = #{orderId}, used_at = CURRENT_TIMESTAMP
        where id = #{userCouponId}
          and user_id = #{userId}
          and status = 'UNUSED'
    </update>

    <!--
      ③ 退券：按订单把券退回 —— 要求见 UserCouponMapper.java#releaseByOrder
      ★★ 这是 ② 的逆向操作，难点不在 SQL 长度，而在【三样都要还原】：

          UPDATE user_coupons
             SET status   = 'UNUSED'
               , order_id = ______        ← ★ 必须清空（写 NULL，不是省略）
               , used_at  = ______        ← ★ 必须清空（写 NULL，不是省略）
           WHERE ______ = #{orderId}      ← 按订单定位
             AND ______                    ← 守卫：只退「确实被这张单用掉」的那张

      ★ 为什么不带 user_id 条件：取消有三条边（用户 / 超时任务 / 管理员），
        后两条拿不到 userId。order_id 本身就是「谁的券」的充分条件。
      ★ 影响行数为 0 是【正常】的（这单没用券）—— 调用方不许把 0 当失败。
    -->
    <update id="releaseByOrder">
        update user_coupons
        set status = 'UNUSED', order_id = null, used_at = null
        where order_id = #{orderId}
          and status = 'USED'
    </update>

</mapper>
