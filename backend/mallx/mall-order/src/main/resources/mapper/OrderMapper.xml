<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallx.order.mapper.OrderMapper">

    <!-- ① 读收货地址：WHERE 里同时做 IDOR 校验。
         不是自己的地址 → 查不出行 → 返回 null → 上层统一返 404。 -->
    <select id="selectAddressForOrder" resultType="com.mallx.order.vo.AddressForOrderVO">
        SELECT receiver_name,
               receiver_phone,
               province,
               city,
               district,
               detail_address
        FROM user_addresses
        WHERE id = #{addressId}
          AND user_id = #{userId}
    </select>

    <!-- ② 读购物车里"已勾选"的项，一条 LEFT JOIN 出下单需要的一切现场（跨 4 表）。
         ★ 必须 LEFT JOIN —— 否则软删的 SKU / 商品会从结果里凭空消失。
         ★ 故意【不】加 AND s.is_deleted = 0 / AND p.is_deleted = 0 / AND p.status = 1：
           失效判定留给 Java，这样才有机会报出「哪件商品因为什么原因不能买」。
         ★ c.selected = TRUE —— PG 的 boolean 列，直接用 TRUE 比较。 -->
    <select id="selectSelectedCartItems" resultType="com.mallx.order.vo.OrderItemSourceVO">
        SELECT c.id                            AS cart_item_id,
               c.sku_id,
               c.quantity,
               s.product_id,
               s.name                          AS sku_name,
               s.price,
               COALESCE(s.image, p.main_image) AS image,
               p.name                          AS product_name,
               p.status                        AS product_status,
               COALESCE(p.is_deleted, 0)       AS product_deleted,
               COALESCE(s.is_deleted, 0)       AS sku_deleted,
               COALESCE(i.available_stock, 0)  AS available_stock
        FROM cart_items c
                 LEFT JOIN product_skus s ON s.id = c.sku_id
                 LEFT JOIN products     p ON p.id = s.product_id
                 LEFT JOIN inventories  i ON i.sku_id = c.sku_id
        WHERE c.user_id = #{userId}
          AND c.selected = TRUE
    </select>

    <!-- ③ 下单成功后清掉已勾选的购物车项（物理删除，cart_items 无 is_deleted 列）。
         ★ 只删 selected = TRUE 的 —— 未勾选的项必须留在车里。 -->
    <delete id="deleteSelectedCartItems">
        DELETE
        FROM cart_items
        WHERE user_id = #{userId}
          AND selected = TRUE
    </delete>

    <!-- ★★★ ④ Day 13 的核心 SQL：CAS 推进订单状态（支付成功）。
         WHERE status = 'PENDING_PAYMENT' 就是 Compare-And-Set：
         「只有现在还是待支付，才允许被我改成已支付」—— 数据库替我们做原子比较。
         影响行数 1 = 抢到；0 = 已被别人付过 / 已取消 → 上层抛 400，整笔事务回滚。

         ★ orders 表没有 version 列 —— 状态字段自己就是「版本号」，
           这就是本方法不需要任何乐观锁工具的原因。

         ★ 为什么【不】带 user_id：归属在 Service 第一步已经分流过；
           带了会让三种 0 行原因（不存在 / 不是你的 / 状态不对）重新糊在一起。

         ⚠️ status 用字面量而不是 #{status}：让「一条 SQL 自己就把语义说清楚」，
            读的人不用回 Service 看传了什么。代价是状态值升级时要改这里。
            （与 deductStock / moveLockedToSold 的纯参数写法风格不同，两种都对。）
         ⚠️ updated_at 必须手写：自定义 XML 的 UPDATE【不走】MetaObjectHandler，
            漏了它这一格就永远停在旧时间。
         ⚠️ paid_at 也手写（不挂 fill）—— 它记的是「业务事实发生的那一刻」，
            不是「这一行被改过」。 -->
    <update id="markPaid">
        UPDATE orders
           SET status     = 'PAID',
               paid_at    = CURRENT_TIMESTAMP,
               updated_at = CURRENT_TIMESTAMP
         WHERE id = #{orderId}
           AND status = 'PENDING_PAYMENT'
    </update>

    <!-- ★★★ ⑤ Day 14 的核心 SQL：CAS 推进订单状态（取消成功）。
         与 ④ markPaid 是【同一条边的两个方向】—— 同一个 WHERE、同一个起点 PENDING_PAYMENT，
         只是一个走向 PAID、一个走向 CANCELLED。

         ★ WHERE status = 'PENDING_PAYMENT' 就是 Compare-And-Set：
           「只有现在还是待支付，才允许被我改成已取消」。
           影响行数 1 = 抢到；0 = 已被别人付过 / 已取消 → 上层抛 400，整笔事务回滚。

         ★★ 这一条 WHERE 同时挡住了三种错误：重复取消、取消已支付的订单、
            以及最凶的「取消与支付并发」—— 两个方向抢同一个状态位，数据库保证只有一个能拿到 1 行。

         ★ 为什么【不】带 user_id：归属在 Service 第一步（requireOwn）已经分流过；
           带了会让三种 0 行原因（不存在 / 不是你的 / 状态不对）重新糊在一起。

         ⚠️ status 用字面量 'CANCELLED' —— 必须与 Java 侧 OrderStatus.CANCELLED 逐字符一致。
            orders.status 列【没有 CHECK 约束】，拼错了数据库不拦你。
         ⚠️ cancelled_at 与 updated_at 都要手写：前者记「业务事实发生的那一刻」（不挂 fill），
            后者是自定义 XML 的 UPDATE 不走 MetaObjectHandler 的补偿。
            （对比：14 列里 cancelled_at 一直是 NULL，本方法是第一次写它。） -->
    <update id="cancelOrder">
        UPDATE orders
           SET status       = 'CANCELLED',
               cancelled_at = CURRENT_TIMESTAMP,
               updated_at   = CURRENT_TIMESTAMP
         WHERE id = #{orderId}
           AND status = 'PENDING_PAYMENT'
    </update>

    <!--
      查「超时未支付」的订单 id（Day 14 第 3 步 · 超时关单）。

      ★★ 不带 user_id 条件 —— 这是本文件里唯一一条「系统视角」的查询。
         定时任务代表系统，有权取消任何人的超时单；用户视角的取消才需要归属校验。

      ★ 只取 id：调用方拿到 id 就去逐单开事务，这些行的其它字段一个都不会看。

      ★ make_interval(mins => ?) 是 PG 原生写法，比拼字符串 interval 干净，
        且参数是 int 类型，不走字符串解析。

      ★ 判据只有「状态 + 时间」两个条件，不需要任何额外的超时标记列（本步零 DDL）。

      ⚠️ XML 里的小于号必须写成 &lt;（直接写小于号会让解析器以为标签开始）。
      ⚠️ 注释里不能出现连续两个减号（本文件 Day 13 已经踩过一次，启动才炸）。
    -->
    <select id="selectTimeoutOrderIds" resultType="java.lang.Long">
        SELECT id
          FROM orders
         WHERE status = 'PENDING_PAYMENT'
           AND created_at &lt; CURRENT_TIMESTAMP - make_interval(mins => #{minutes})
         ORDER BY id
    </select>

    <!-- ★★★ ⑥ Day 15 的核心 SQL：CAS 推进订单状态（发货成功）。
         ★ 这是全文件【唯一一条起点不是 PENDING_PAYMENT 的边】——
           PAID 变成 SHIPPED，只能排在支付成功之后，与支付/取消不抢同一个状态位。

         ★ WHERE status = 'PAID' 就是 Compare-And-Set：
           「只有现在还是已支付，才允许被我改成已发货」。
           影响行数 1 = 抢到；0 = 订单不存在 / 已被别人先发货 / 状态不是 PAID → 上层抛 400。

         ★ 本语句【不碰库存】：available / locked / sold 三格一格不动 ——
           货的归属在支付那一刻（locked 变 sold）就已经定死了，
           发货推进的是【物流状态】，不是库存状态。
           所以它既不需要事务，也不写 inventory_logs 流水。

         ★ 为什么【不】带 user_id：这是管理端动作（权限 order:ship），
           管理员有权给任何人的订单发货 —— 连 userId 都不接收。

         ⚠️ shipped_at 与 updated_at 都要手写：前者记「业务事实发生的那一刻」（不挂 fill），
            后者是自定义 XML 的 UPDATE 不走 MetaObjectHandler 的补偿。
            （对比：15 列里 shipped_at 一直是 NULL，本语句是第一次写它。）
         ⚠️ status 用字面量 'SHIPPED' —— 必须与 Java 侧 OrderStatus.SHIPPED 逐字符一致。
            orders.status 列【没有 CHECK 约束】，拼错了数据库不拦你。 -->
    <update id="shipOrder">
        UPDATE orders
           SET status     = 'SHIPPED',
               shipped_at = CURRENT_TIMESTAMP,
               updated_at = CURRENT_TIMESTAMP
         WHERE id = #{orderId}
           AND status = 'PAID'
    </update>

    <!-- ★★★ ⑦ Day 15 的核心 SQL：CAS 推进订单状态（确认收货）。
         与 ⑥ shipOrder 是孪生结构，但有三处相反：
           ① 本语句服务的是【C 端用户动作】→ 归属由 Service 的 requireOwn 先分流（404）；
           ② 起点是 SHIPPED 而不是 PAID（终点 COMPLETED）；
           ③ 依然【不碰库存】。

         ★ WHERE status = 'SHIPPED' 就是 Compare-And-Set：
           「只有现在还是已发货，才允许被我改成已完成」。
           影响行数 1 = 抢到；0 = 已被别人确认过 / 状态不是 SHIPPED → 上层抛 400。

         ★ 为什么【不】带 user_id：归属在 Service 第一步已经分流过；
           带了会让三种 0 行原因（不存在 / 不是你的 / 状态不对）重新糊在一起，
           上层就没法稳定地把它翻成「400 状态不允许确认收货」。

         ⚠️ completed_at 与 updated_at 都要手写。
            （对比：15 列里 completed_at 一直是 NULL，本语句是第一次写它。） -->
    <update id="confirmReceipt">
        UPDATE orders
           SET status       = 'COMPLETED',
               completed_at = CURRENT_TIMESTAMP,
               updated_at   = CURRENT_TIMESTAMP
         WHERE id = #{orderId}
           AND status = 'SHIPPED'
    </update>

    <!--
      ★★★ ⑧ Day 17 的核心 SQL：管理端订单列表（★★ 数据权限反转的第一条查询）

      要求见 OrderMapper.java#selectAdminOrders 与
      docs/daily/Day-17-管理端订单与库存.md §3.1。要点：

        · ★★ FROM orders o LEFT JOIN users u ON u.id = o.user_id
          JOIN users 是【只读跨表查询】，不是模块依赖（与本文件 JOIN
          user_addresses / cart_items 同一性质）。
        · ★★ 归属条件【不存在】：这里【没有】AND o.user_id = #{userId}。
          防线不在 SQL 里，而在 Controller 的 @PreAuthorize 权限码上。
          ⚠️ 这是一个「允许发生」的缺席，不是一个「忘了写」的缺席 ——
             若给本语句补上归属条件，管理端就再也看不到别人的单，功能直接失效；
             若把权限码摘掉，它就从管理端接口退化成「任何登录用户能拉全站订单」。
             两头都是承重结构，改动前请先读 §0.2。
        · 可选的 status 过滤：test="status != null and status != ''"
          （只判 != null 时，?status= 空串会拼出 AND o.status = '' → 静默 0 行）
        · 可选的 userId 过滤：★ 这是【筛选条件】，不是权限边界 ——
          运营想看「某个买家的单」时用它，有没有它都不影响「谁能调这个接口」。
        · 显式列 + 别名【全用下划线】：o.user_id AS user_id、
          COALESCE(u.nickname, '用户****') AS user_nickname、
          o.total_amount AS total_amount、o.pay_amount AS pay_amount、
          o.receiver_name AS receiver_name、o.receiver_phone AS receiver_phone、
          o.created_at AS created_at。
          ⚠️ 别名写成 AS userNickname 会被 PG 折成 usernickname，字段静默为 null 且不报错。
          ⚠️ 昵称可空必须 COALESCE —— 裸 NULL 会让前端多一条「判断空」的分支。
        · ORDER BY o.id DESC（不带排序的分页 = 随机翻页）
        · ★ 首参 IPage 由 Java 侧传（分页插件靠它改写 SQL），XML 里【不用写】LIMIT/OFFSET
    -->
    <select id="selectAdminOrders" resultType="com.mallx.order.vo.AdminOrderVO">
        SELECT o.id AS id, o.user_id AS user_id, COALESCE(u.nickname, '用户****') AS user_nickname, o.total_amount AS total_amount,
               o.pay_amount AS pay_amount, o.receiver_name AS receiver_name, o.receiver_phone AS receiver_phone,
               o.status AS status, o.order_no AS order_no,
               o.created_at AS created_at
          FROM orders o
          LEFT JOIN users u ON u.id = o.user_id
          WHERE 1 = 1
        <if test="status != null and status != ''">
            AND o.status = #{status}
        </if>
        <if test="userId != null">
            AND o.user_id = #{userId}
        </if>
        ORDER BY o.id DESC

    </select>

</mapper>
