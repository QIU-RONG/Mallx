              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"业务码 code=200\", () => pm.expect(body.code).to.eql(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "结算预览（可用券）",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coupons?page=1&size=10"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"业务码 code=200\", () => pm.expect(body.code).to.eql(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "提交订单（返回 id 数组）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"addressId\": \"{{addressId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"业务码 code=200\", () => pm.expect(body.code).to.eql(200));",
                  "const ids = body.data || [];",
                  "pm.test(\"返回至少一张订单\", () => pm.expect(ids.length).to.be.above(0));",
                  "if (ids.length) { pm.collectionVariables.set(\"orderId\", ids[0]); }",
                  "pm.collectionVariables.set(\"orderIds\", JSON.stringify(ids));"
                ]
              }
            }
          ]
        },
        {
          "name": "批量支付（合并支付）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/batch"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"orderIds\": [\"{{orderId}}\"], \"method\": \"BALANCE\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"业务码 code=200\", () => pm.expect(body.code).to.eql(200));"
                ]
              }
            }
          ]
        }
      ]
