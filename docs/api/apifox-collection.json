  ],
  "item": [
    {
      "name": "01 认证",
      "item": [
        {
          "name": "C 端登录（demo）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"demo\", \"password\": \"demo123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"业务码 code=200\", () => pm.expect(body.code).to.eql(200));",
                  "pm.collectionVariables.set(\"userToken\", body.data.token);",
                  "pm.test(\"拿到 userToken\", () => pm.expect(body.data.token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "管理员登录（admin）",
          "request": {
            "method": "POST",
            "header": [
              {
