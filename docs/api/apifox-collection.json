{
  "info": {
    "name": "MallX 验收集合（Apifox 导入）",
    "description": "按 01→07 顺序跑；登录请求会自动写入 userToken/adminToken/merchantToken。基础地址见环境变量 baseUrl（默认 http://localhost:8081）。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "merchantToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "skuId",
      "value": "1"
    },
    {
      "key": "shopId",
      "value": "1"
    },
    {
      "key": "addressId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "orderIds",
      "value": ""
    },
    {
      "key": "cartItemId",
      "value": ""
