    {
      "name": "03 购物车 → 下单 → 支付",
      "item": [
        {
          "name": "加入购物车",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cart"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"skuId\": \"{{skuId}}\", \"quantity\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"业务码 code=200\", () => pm.expect(body.code).to.eql(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "查看购物车（并记下 cartItemId）",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cart"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"业务码 code=200\", () => pm.expect(body.code).to.eql(200));",
                  "const items = (body.data && body.data.items) || [];",
                  "if (items.length) { pm.collectionVariables.set(\"cartItemId\", items[0].id); }",
                  "pm.test(\"购物车有商品\", () => pm.expect(items.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "勾选购物车项",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cart/select"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"itemIds\": [\"{{cartItemId}}\"], \"selected\": true}",
              "options": {
                "raw": {
                  "language": "json"
