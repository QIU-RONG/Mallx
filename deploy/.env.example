# MallX 编排环境变量模板 —— 复制为 deploy/.env 后按需修改。
# ★ .env 已在 .gitignore 里排除，不要把真实密钥提交进仓库。
# ★ 变量名与 deploy/docker-compose.app.yml 里的 ${...} 逐字对应；
#   多一个空格都会让它变成另一个变量（`DB_NAME = mallx` 是错的）。

# --- 数据库 ---
DB_NAME=mallx
DB_USERNAME=mallx
# ⚠️ 改掉它。`:?` 语法要求它必须存在，但【不会】替你检查强度。
DB_PASSWORD=mallx123

# --- 应用 ---
# 宿主对外端口（容器内固定 8080）
APP_PORT=8080
# ⚠️⚠️ 必须换成随机长串。JWT 的签名密钥一旦泄露，
#      任何人都能自己签一个携带任意权限码的 token —— 整套 RBAC 归零。
#      生成一个：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-48-byte-string
# 容器内 JVM 参数（按机器内存调整）
JAVA_OPTS=-Xmx512m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC
