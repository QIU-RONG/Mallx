# ==============================================================================
# 生产环境变量样例 —— cp .env.prod.example .env 然后逐项改
# ⚠️ .env 已在 .gitignore 里，**绝不要**把它提交进仓库
# ==============================================================================

# ---------- 应用镜像 ----------
# ★★ 必须是一个【不可变的具体版本】，禁止 latest：
#    latest 让「线上跑的是哪一版」无法回答，也让回滚变成伪命题。
IMAGE_REGISTRY=ghcr.io/qiu-rong/mallx-server
IMAGE_TAG=1.4.0

# ---------- 域名 / 反代 ----------
# ★ Caddy 用它申请证书；没设的话 compose 会直接拒绝启动（:?)
APP_DOMAIN=mallx.example.com

# ---------- 数据库 ----------
DB_NAME=mallx
DB_USERNAME=mallx
DB_PASSWORD=               # ★★ 必须（生产值，别用开发库那套）

# ---------- 认证 ----------
# ★★★ 必须：JWT 签名密钥泄露 ⇒ 任何人可以自签一个带任意权限码的 token，RBAC 直接归零
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------- 中间件 ----------
REDIS_PASSWORD=            # ★ 必须（Redis 无认证被扫到就是免费 KV）
RABBITMQ_USERNAME=mallx
RABBITMQ_PASSWORD=mallx

# ---------- 资源 ----------
# ★ 给应用的内存上限：JVM 按 -XX:MaxRAMPercentage=75 从它算堆，
#   没有这个限额时「容器感知」只能按宿主内存算，等于没有。
APP_MEM_LIMIT=768m
